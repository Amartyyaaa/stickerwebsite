# Local development needs none of these: the database is a file in ./data
# and customer uploads go to ./uploads.

# Production database (Turso / libSQL), for example libsql://printyourvibe-yourname.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Folder for custom-studio uploads (originals for printing, plus web previews).
# Defaults to ./uploads. On a server, point it at a folder that is backed up.
UPLOADS_DIR=

# The public address of the store, used in page metadata and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
