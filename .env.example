# Local development needs none of these: the database is a file in ./data,
# uploads go to ./uploads, emails are saved to ./data/outbox, and online
# payments open a test screen.

# The public address of the store, used in emails, page metadata and share links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production database (Turso / libSQL), for example libsql://printyourvibe-yourname.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Folder for custom-studio uploads (originals for printing, plus web previews).
# Defaults to ./uploads. On a server, point it at a folder that is backed up.
UPLOADS_DIR=

# Sign-in (Better Auth). Required in production: generate a secret with
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site address again (defaults to NEXT_PUBLIC_SITE_URL)
BETTER_AUTH_URL=
# Optional "Continue with Google": create an OAuth client in Google Cloud and add
# <your site>/api/auth/callback/google as an authorised redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails that can open the admin panel (Step 4), comma-separated
ADMIN_EMAILS=

# Razorpay (Dashboard → Account & Settings → API keys). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL <your site>/api/payments/razorpay/webhook,
# events payment.captured, order.paid and payment.failed
RAZORPAY_WEBHOOK_SECRET=
# Only for testing a production build on your own computer without Razorpay keys.
# Ignored when NEXT_PUBLIC_SITE_URL is a real address, so it can't mark live orders paid.
PAYMENTS_MOCK=

# Email (Resend). Without a key, emails are saved to data/outbox instead of being sent.
RESEND_API_KEY=
# Must be an address on a domain you've verified in Resend
MAIL_FROM=PrintYourVibe <orders@yourdomain.in>
# Where new-order alerts go (defaults to the store contact email in settings)
ORDER_ALERT_EMAIL=

# Backups to Cloudflare R2 (DEPLOY.md, step 8). The server backs up the database
# and photos every night at 4 am; `sudo pyv backup` runs one straight away.
# Create an R2 bucket, then an API token with "Object Read & Write" for that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Free preview on Vercel (VERCEL.md). Leave these empty on your own server.
# Turso hosted database: its libsql:// address and a read-write token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Blob photo storage (added by Vercel when you connect a Blob store)
BLOB_READ_WRITE_TOKEN=
# Any long random text; Vercel Cron sends it to run the daily clean-up
CRON_SECRET=
# 1 = add the demo designs on the first build, while the store has no products
SEED_SAMPLE=
